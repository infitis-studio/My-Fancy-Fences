<Window x:Class="My_Fancy_Fences.ShortcutCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Przypisz skrót"
        Width="460"
        Height="315"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFE7E2E4"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Foreground" Value="#FFE7E2E4"/>
            <Setter Property="Background" Value="#FF2A2A2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#FF39393E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#F218181B"
            BorderBrush="#FF323238"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="12,12,0,0"
                    Background="#FF202024"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="Keyboard"
                                                  Width="18"
                                                  Height="18"
                                                  Foreground="#FFCFC7CA"/>
                        <TextBlock Text="Przypisz skrót"
                                   Margin="10,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Width="32"
                            Height="28"
                            MinWidth="0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="×"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="26,22,26,18">
                <TextBlock x:Name="DescriptionText"
                           TextWrapping="Wrap"
                           Foreground="#FFCFC7CA"/>
                <Border Margin="0,18,0,0"
                        Height="72"
                        CornerRadius="10"
                        Background="#FF101013"
                        BorderBrush="#FF313137"
                        BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="ShortcutText"
                                   Text="Wciśnij kombinację klawiszy"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#FFEFEAEC"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="HintText"
                           Text="Wymagany jest przynajmniej jeden modyfikator: Ctrl, Alt, Shift albo Win.&#x0a;Sam pojedynczy klawisz nie wystarczy."
                           Margin="0,10,0,0"
                           FontSize="11"
                           Foreground="#FFA9A2A5"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="#FF202024"
                    CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <Button Content="Anuluj"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Content="Zatwierdź"
                            Background="#FF2E6F49"
                            IsEnabled="False"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
