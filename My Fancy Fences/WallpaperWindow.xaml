<Window x:Class="My_Fancy_Fences.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Tapety"
        Width="1040"
        Height="680"
        MinWidth="760"
        MinHeight="480"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFE7E2E4"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Topmost="False">
    <Window.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE7E2E4"/>
            <Setter Property="Background" Value="#FF29292B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF343438"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="MaxWidth" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Margin="0,2"
                                                        CornerRadius="2"
                                                        Background="#35FFFFFF"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#66FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar"
               BasedOn="{StaticResource MinimalScrollBarStyle}"/>

        <Style x:Key="RoundSearchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFE7E2E4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle"
                                     Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#FF3A3A3F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#FF46464B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortButtonStyle"
               TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFA9A2A5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                CornerRadius="6"
                                Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF29292D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF36363B"/>
                                <Setter Property="Foreground" Value="#FFF1EDEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoritesToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#FFE3DDE0"/>
            <Setter Property="Background" Value="#FF303035"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FF3A3A40"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FF50323B"/>
                                <Setter Property="Foreground" Value="#FFFFD7DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteHeartButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="31"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Background" Value="#CC2D2D30"/>
            <Setter Property="Foreground" Value="#FFD0D0D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeartBackground"
                                CornerRadius="15.5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeartBackground" Property="Background" Value="#EE3A3A3F"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFF4D64"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE7E2E4"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="4"
                                    Background="#FF242427"
                                    BorderBrush="#FF3E3E43"
                                    BorderThickness="1">
                                <Path x:Name="Mark"
                                      Width="8"
                                      Height="6"
                                      Data="M 0 2.5 L 3 5.5 L 8 0"
                                      Stroke="White"
                                      StrokeThickness="1.7"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="#FFE7E2E4"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF46464C"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF58585F"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="#FFC7C0C3"/>
            <Setter Property="Background" Value="#FF252529"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FF303034"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FF3A3A3F"/>
                                <Setter Property="Foreground" Value="#FFF1EDEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Background" Value="#FF252529"/>
            <Setter Property="Foreground" Value="#FFE7E2E4"/>
            <Setter Property="BorderBrush" Value="#FF3B3B40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#FF252529"
                                                BorderBrush="#FF3B3B40"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid Margin="9,0,8,0">
                                                <ContentPresenter Content="{Binding SelectedItem.Content,
                                                                                    RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="#FFE7E2E4"/>
                                                <iconPacks:PackIconLucide Kind="ChevronDown"
                                                                          Width="14"
                                                                          Height="14"
                                                                          Foreground="#FFA9A2A5"
                                                                          HorizontalAlignment="Right"
                                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,3,0,0"
                                        Padding="4"
                                        CornerRadius="5"
                                        Background="#FF252529"
                                        BorderBrush="#FF3B3B40"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="9,0"/>
                        <Setter Property="Foreground" Value="#FFE7E2E4"/>
                        <Setter Property="Background" Value="#FF252529"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            CornerRadius="4"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FF343438"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FF44444A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WallpaperSourceComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="#FF252529"/>
            <Setter Property="Foreground" Value="#FFE7E2E4"/>
            <Setter Property="BorderBrush" Value="#FF3B3B40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SourceToggleBorder"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="5">
                                            <Grid Margin="9,0,8,0">
                                                <ContentPresenter Content="{Binding Tag,
                                                                                    RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <iconPacks:PackIconLucide Kind="ChevronDown"
                                                                          Width="14"
                                                                          Height="14"
                                                                          Foreground="#FFC7C1C4"
                                                                          HorizontalAlignment="Right"
                                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SourceToggleBorder" Property="Background" Value="#FF303034"/>
                                                <Setter TargetName="SourceToggleBorder" Property="BorderBrush" Value="#FF4A4A50"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SourceToggleBorder" Property="Background" Value="#FF303034"/>
                                                <Setter TargetName="SourceToggleBorder" Property="BorderBrush" Value="#FF4A4A50"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,5,0,0"
                                        Padding="4"
                                        CornerRadius="5"
                                        Background="#FF252529"
                                        BorderBrush="#FF3B3B40"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="9,0"/>
                        <Setter Property="Foreground" Value="#FFE7E2E4"/>
                        <Setter Property="Background" Value="#FF252529"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="SourceItemBorder"
                                            CornerRadius="7"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SourceItemBorder" Property="Background" Value="#FF38383E"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SourceItemBorder" Property="Background" Value="#FF44444A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TagChipTemplate">
            <Button Tag="{Binding Text}"
                    Margin="5,0,0,0"
                    Padding="7,2"
                    MinWidth="0"
                    MinHeight="0"
                    Height="17"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{Binding Background}"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="RemoveTagButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TagChipBorder"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TagChipBorder" Property="Opacity" Value=".86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TagChipBorder" Property="Opacity" Value=".72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Foreground="#F21B1B1E"
                           FontSize="10"
                           FontWeight="SemiBold"
                           LineHeight="12">
                    <Run Text="#"/>
                    <Run Text="{Binding Text}"/>
                </TextBlock>
            </Button>
        </DataTemplate>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFE7E2E4"/>
            <Setter Property="CaretBrush" Value="#FFE7E2E4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WallpaperCardStyle" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="238"/>
            <Setter Property="Height" Value="158"/>
            <Setter Property="Background" Value="#FF1D1D20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                ClipToBounds="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value=".86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFE7E2E4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterWindowBorder"
            BorderBrush="#FF3A3438"
            BorderThickness="1"
            CornerRadius="13"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="OuterBackgroundStart" Color="#FF191719" Offset="0"/>
                <GradientStop x:Name="OuterBackgroundMiddle" Color="#FF141416" Offset=".5"/>
                <GradientStop x:Name="OuterBackgroundEnd" Color="#FF111113" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="46"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarBorder"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="TitleBackgroundStart" Color="#FF2B2025" Offset="0"/>
                        <GradientStop x:Name="TitleBackgroundMiddle" Color="#FF1D1C20" Offset=".45"/>
                        <GradientStop x:Name="TitleBackgroundEnd" Color="#FF171719" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,0,7,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="Wallpaper"
                                                  Width="18"
                                                  Height="18"
                                                  Margin="0,0,10,0"
                                                  Foreground="#FFC9C2C5"/>
                        <TextBlock x:Name="WindowTitleText"
                                   Text="Tapety z Wallhaven"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                Width="34"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FFE7E2E4"
                                Cursor="Hand"
                                ToolTip="Minimalizuj"
                                Click="MinimizeButton_Click">
                            <iconPacks:PackIconLucide Kind="Minus" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                Width="34"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FFE7E2E4"
                                Cursor="Hand"
                                ToolTip="Pełny ekran"
                                Click="MaximizeButton_Click">
                            <iconPacks:PackIconLucide x:Name="MaximizeIcon"
                                                      Kind="Square"
                                                      Width="14"
                                                      Height="14"/>
                        </Button>
                        <Button Content="×"
                                Style="{StaticResource WindowCloseButtonStyle}"
                                Width="34"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FFE7E2E4"
                                FontSize="20"
                                Cursor="Hand"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SourceToolbarBorder"
                    Grid.Row="1"
                    BorderBrush="#FF302C30"
                    BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="ToolbarBackgroundStart" Color="#CC2B2025" Offset="0"/>
                        <GradientStop x:Name="ToolbarBackgroundMiddle" Color="#FF1D1D20" Offset=".55"/>
                        <GradientStop x:Name="ToolbarBackgroundEnd" Color="#FF141416" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="15,10,15,11" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="WallpaperSourceComboBox"
                              Grid.Column="0"
                              Width="220"
                              Height="31"
                              Margin="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Tag="Wybrane źródło: Wallhaven"
                              Style="{StaticResource WallpaperSourceComboBoxStyle}"
                              SelectionChanged="WallpaperSourceComboBox_SelectionChanged"
                              SelectedIndex="0">
                        <ComboBoxItem x:Name="WallhavenSourceItem" Tag="wallhaven">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="Image"
                                                          Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Foreground="#FF62A8FF"/>
                                <TextBlock Text="Wallhaven" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem x:Name="MoeWallsSourceItem" Tag="moewalls">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="Clapperboard"
                                                          Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Foreground="#FF5EE08A"/>
                                <TextBlock Text="MoeWalls" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>

                    <Grid x:Name="SearchBoxRoot"
                          Grid.Column="2"
                          Panel.ZIndex="50"
                          Width="380"
                          MinWidth="250"
                          MaxWidth="380"
                          Height="34"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          ClipToBounds="False">
                        <Border CornerRadius="7"
                                Background="#FF222225"
                                BorderBrush="#FF37373B"
                                BorderThickness="1"/>
                        <Grid Margin="10,0,5,0"
                              ClipToBounds="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Kind="Search"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="0,0,8,0"
                                                      Foreground="#FFA9A2A5"
                                                      VerticalAlignment="Center"/>
                            <Grid Grid.Column="1"
                                  Panel.ZIndex="20"
                                  VerticalAlignment="Center"
                                  ClipToBounds="False">
                                <Grid x:Name="TagsViewport"
                                      Panel.ZIndex="80"
                                      Width="145"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      ClipToBounds="True"
                                      MouseEnter="TagsViewport_MouseEnter"
                                      MouseLeave="TagsViewport_MouseLeave">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <ItemsControl x:Name="TagsItemsControl"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      ItemTemplate="{StaticResource TagChipTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Left"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ItemsControl x:Name="HiddenTagsItemsControl"
                                                      Visibility="Collapsed"
                                                      HorizontalAlignment="Left"
                                                      Panel.ZIndex="300"
                                                      VerticalAlignment="Center"
                                                      ItemTemplate="{StaticResource TagChipTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Left"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="SearchTextBox"
                                         MinWidth="70"
                                         Margin="0,0,150,0"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         MouseEnter="SearchTextBox_MouseEnter"
                                         TextChanged="SearchTextBox_TextChanged"
                                         KeyDown="SearchTextBox_KeyDown"/>
                            </Grid>
                            <TextBlock x:Name="SearchPlaceholderText"
                                       Grid.Column="1"
                                       Text="Wpisz tagi..."
                                       Foreground="#70A9A2A5"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Panel.ZIndex="1"
                                    Style="{StaticResource RoundSearchButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="AddTagButton_Click">
                                <iconPacks:PackIconLucide Kind="Plus" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                        <Canvas x:Name="HiddenTagsCanvas"
                                Panel.ZIndex="500"
                                Width="380"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ClipToBounds="False"
                                Visibility="Collapsed"
                                Background="Transparent"
                                MouseEnter="TagsViewport_MouseEnter"
                                MouseLeave="TagsViewport_MouseLeave">
                            <Border x:Name="HiddenTagsOverlayBackground"
                                    Width="0"
                                    Height="25"
                                    CornerRadius="4"
                                    Background="#F2222225"
                                    BorderBrush="#6637373B"
                                    BorderThickness="1"
                                    MouseLeave="TagsViewport_MouseLeave"/>
                            <ItemsControl x:Name="HiddenTagsOverlayItemsControl"
                                          Canvas.Top="3"
                                          ItemTemplate="{StaticResource TagChipTemplate}"
                                          MouseLeave="TagsViewport_MouseLeave">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Canvas>
                    </Grid>

                    <ToggleButton x:Name="FavoritesToggleButton"
                                  Grid.Column="4"
                                  Content="Ulubione"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource FavoritesToggleStyle}"
                                  Checked="FavoritesToggleButton_Checked"
                                  Unchecked="FavoritesToggleButton_Checked">
                        <ToggleButton.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="Heart"
                                                              Width="15"
                                                              Height="15"
                                                              Margin="0,0,8,0"
                                                              Foreground="#FFFF4D64"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ToggleButton.ContentTemplate>
                    </ToggleButton>

                    <StackPanel x:Name="WallhavenTopSortPanel"
                                Grid.Column="6"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <RadioButton x:Name="LatestSortButton"
                                     GroupName="Sorting"
                                     Content="Latest"
                                     Tag="date_added"
                                     IsChecked="True"
                                     Style="{StaticResource SortButtonStyle}"
                                     Checked="SortButton_Checked"/>
                        <RadioButton x:Name="HotSortButton"
                                     GroupName="Sorting"
                                     Content="Hot"
                                     Tag="hot"
                                     Margin="4,0"
                                     Style="{StaticResource SortButtonStyle}"
                                     Checked="SortButton_Checked"/>
                        <RadioButton x:Name="ToplistSortButton"
                                     GroupName="Sorting"
                                     Content="Toplist"
                                     Tag="toplist"
                                     Style="{StaticResource SortButtonStyle}"
                                     Checked="SortButton_Checked"/>
                    </StackPanel>
                    <StackPanel x:Name="MoeWallsTopSortPanel"
                                Grid.Column="6"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <RadioButton x:Name="MoeWallsLatestSortButton"
                                     GroupName="MoeWallsSorting"
                                     Content="Latest"
                                     Tag="latest"
                                     Style="{StaticResource SortButtonStyle}"
                                     Checked="MoeWallsSortButton_Checked"/>
                        <RadioButton x:Name="MoeWallsOldestSortButton"
                                     GroupName="MoeWallsSorting"
                                     Content="Oldest"
                                     Tag="oldest"
                                     Margin="4,0"
                                     Style="{StaticResource SortButtonStyle}"
                                     Checked="MoeWallsSortButton_Checked"/>
                        <RadioButton x:Name="MoeWallsMostDiscussedSortButton"
                                     GroupName="MoeWallsSorting"
                                     Content="Most discussed"
                                     Tag="most-discussed"
                                     Margin="4,0"
                                     Style="{StaticResource SortButtonStyle}"
                                     Checked="MoeWallsSortButton_Checked"/>
                        <RadioButton x:Name="MoeWallsMostUpvotedSortButton"
                                     GroupName="MoeWallsSorting"
                                     Content="Most upvoted"
                                     Tag="most-upvoted"
                                     Style="{StaticResource SortButtonStyle}"
                                     Checked="MoeWallsSortButton_Checked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Grid.RowSpan="2"
                  Panel.ZIndex="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SidebarBorder"
                        BorderBrush="#FF302C30"
                        CornerRadius="0,0,0,12"
                        BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="SidebarBackgroundStart" Color="#FF2B2025" Offset="0"/>
                            <GradientStop x:Name="SidebarBackgroundMiddle" Color="#FF211C20" Offset=".45"/>
                            <GradientStop x:Name="SidebarBackgroundEnd" Color="#FF181719" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="WallhavenFiltersPanel"
                                    Margin="17,15,17,15">
                            <TextBlock x:Name="CategoriesLabelText"
                                       Text="Kategorie"
                                       Foreground="#FF9D969A"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <ToggleButton x:Name="GeneralCheckBox"
                                          Content="General"
                                          IsChecked="True"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Checked="Filter_Changed"
                                          Unchecked="Filter_Changed"/>
                            <ToggleButton x:Name="AnimeCheckBox"
                                          Content="Anime"
                                          IsChecked="True"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Checked="Filter_Changed"
                                          Unchecked="Filter_Changed"/>
                            <ToggleButton x:Name="PeopleCheckBox"
                                          Content="People"
                                          IsChecked="True"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Checked="Filter_Changed"
                                          Unchecked="Filter_Changed"/>

                            <Border Height="1" Margin="0,12" Background="#FF332E32"/>

                            <TextBlock x:Name="PurityLabelText"
                                       Text="Czystość"
                                       Foreground="#FF9D969A"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <ToggleButton x:Name="SfwCheckBox"
                                          Content="SFW"
                                          IsChecked="True"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Checked="Filter_Changed"
                                          Unchecked="Filter_Changed"/>
                            <ToggleButton x:Name="SketchyCheckBox"
                                          Content="Sketchy"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Checked="Filter_Changed"
                                          Unchecked="Filter_Changed"/>

                            <Border Height="1" Margin="0,12" Background="#FF332E32"/>

                            <TextBlock x:Name="ResolutionLabelText"
                                       Text="Resolution"
                                       Foreground="#FF9D969A"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="ResolutionComboBox"
                                      SelectionChanged="FilterComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="ResolutionAnyItem" Content="Any" Tag=""/>
                                <ComboBoxItem Content="1920×1080" Tag="1920x1080"/>
                                <ComboBoxItem Content="2560×1440" Tag="2560x1440"/>
                                <ComboBoxItem Content="3840×2160" Tag="3840x2160"/>
                                <ComboBoxItem Content="5120×2880" Tag="5120x2880"/>
                            </ComboBox>

                            <TextBlock x:Name="RatioLabelText"
                                       Text="Ratio"
                                       Foreground="#FF9D969A"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="RatioComboBox"
                                      SelectionChanged="FilterComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="RatioAnyItem" Content="Any" Tag=""/>
                                <ComboBoxItem Content="16:9" Tag="16x9"/>
                                <ComboBoxItem Content="16:10" Tag="16x10"/>
                                <ComboBoxItem Content="21:9" Tag="21x9"/>
                                <ComboBoxItem Content="4:3" Tag="4x3"/>
                                <ComboBoxItem x:Name="RatioPortraitItem" Content="Portrait" Tag="portrait"/>
                            </ComboBox>

                            <TextBlock x:Name="ColorLabelText"
                                       Text="Color"
                                       Foreground="#FF9D969A"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="ColorComboBox"
                                      SelectionChanged="FilterComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="ColorAnyItem" Content="Any" Tag=""/>
                                <ComboBoxItem x:Name="ColorRedItem" Content="Red" Tag="cc0000"/>
                                <ComboBoxItem x:Name="ColorOrangeItem" Content="Orange" Tag="ea4c00"/>
                                <ComboBoxItem x:Name="ColorYellowItem" Content="Yellow" Tag="e7d600"/>
                                <ComboBoxItem x:Name="ColorGreenItem" Content="Green" Tag="00aa55"/>
                                <ComboBoxItem x:Name="ColorBlueItem" Content="Blue" Tag="0066cc"/>
                                <ComboBoxItem x:Name="ColorPurpleItem" Content="Purple" Tag="9900cc"/>
                                <ComboBoxItem x:Name="ColorBlackItem" Content="Black" Tag="000000"/>
                                <ComboBoxItem x:Name="ColorWhiteItem" Content="White" Tag="ffffff"/>
                            </ComboBox>
                        </StackPanel>
                            <StackPanel x:Name="MoeWallsFiltersPanel"
                                    Margin="17,15,17,15"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="MoeWallsCategoryLabelText"
                                       Text="Kategoria"
                                       Foreground="#FF9D969A"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="MoeWallsCategoryComboBox"
                                      SelectionChanged="FilterComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="MoeWallsCategoryAnyItem" Content="Any" Tag=""/>
                                <ComboBoxItem Content="Anime" Tag="anime"/>
                                <ComboBoxItem Content="Games" Tag="games"/>
                                <ComboBoxItem Content="Superhero" Tag="superhero"/>
                                <ComboBoxItem Content="Nature" Tag="nature"/>
                                <ComboBoxItem Content="Car" Tag="car"/>
                                <ComboBoxItem Content="TV &amp; Movie" Tag="tv"/>
                                <ComboBoxItem Content="Holiday" Tag="holiday"/>
                                <ComboBoxItem Content="Animal" Tag="animal"/>
                                <ComboBoxItem Content="Fantasy" Tag="fantasy"/>
                                <ComboBoxItem Content="Space" Tag="space"/>
                                <ComboBoxItem Content="Horror" Tag="horror"/>
                                <ComboBoxItem Content="Technology" Tag="technology"/>
                                <ComboBoxItem Content="Football" Tag="football"/>
                                <ComboBoxItem Content="Japan" Tag="japan"/>
                                <ComboBoxItem Content="Hello Kitty" Tag="hello-kitty"/>
                            </ComboBox>

                            <TextBlock x:Name="MoeWallsResolutionLabelText"
                                       Text="Rozdzielczość"
                                       Foreground="#FF9D969A"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="MoeWallsResolutionComboBox"
                                      SelectionChanged="FilterComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="MoeWallsResolutionAnyItem" Content="Any" Tag=""/>
                                <ComboBoxItem Content="HD" Tag="hd"/>
                                <ComboBoxItem Content="2K" Tag="2k"/>
                                <ComboBoxItem Content="4K" Tag="4k"/>
                                <ComboBoxItem Content="Ultrawide" Tag="ultrawide"/>
                                <ComboBoxItem Content="Mobile" Tag="mobile"/>
                            </ComboBox>

                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="WallpaperContentBackgroundStart" Color="#FF181416" Offset="0"/>
                            <GradientStop x:Name="WallpaperContentBackgroundMiddle" Color="#FF141316" Offset=".55"/>
                            <GradientStop x:Name="WallpaperContentBackgroundEnd" Color="#FF101113" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <ScrollViewer x:Name="WallpapersScrollViewer"
                                  Margin="8"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="WallpapersScrollViewer_ScrollChanged">
                        <ItemsControl x:Name="WallpapersItemsControl"
                                      Tag="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource WallpaperCardStyle}"
                                            Tag="{Binding}"
                                            Click="WallpaperButton_Click"
                                            MouseEnter="WallpaperButton_MouseEnter"
                                            MouseLeave="WallpaperButton_MouseLeave">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailImage}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <MediaElement LoadedBehavior="Manual"
                                                          UnloadedBehavior="Stop"
                                                          Stretch="UniformToFill"
                                                          Volume="0"
                                                          Visibility="Collapsed"
                                                          Opacity="0"
                                                          MediaOpened="WallpaperVideo_MediaOpened"
                                                          MediaFailed="WallpaperVideo_MediaFailed"
                                                          MediaEnded="WallpaperVideo_MediaEnded"
                                                          Unloaded="WallpaperVideo_Unloaded"/>
                                            <Border Width="42"
                                                    Height="42"
                                                    CornerRadius="12"
                                                    Background="#CC16181E"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <iconPacks:PackIconLucide Kind="LoaderCircle"
                                                                          Width="22"
                                                                          Height="22"
                                                                          Foreground="#DDE7E2E4"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          RenderTransformOrigin="0.5,0.5">
                                                    <iconPacks:PackIconLucide.RenderTransform>
                                                        <RotateTransform/>
                                                    </iconPacks:PackIconLucide.RenderTransform>
                                                    <iconPacks:PackIconLucide.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0"
                                                                                     To="360"
                                                                                     Duration="0:0:0.85"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </iconPacks:PackIconLucide.Triggers>
                                                </iconPacks:PackIconLucide>
                                            </Border>
                                            <Button Tag="{Binding}"
                                                    Style="{StaticResource FavoriteHeartButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,8,8,0"
                                                    Click="FavoriteButton_Click">
                                                <iconPacks:PackIconLucide Kind="Heart"
                                                                          Width="17"
                                                                          Height="17"/>
                                            </Button>
                                            <Border VerticalAlignment="Bottom"
                                                    Padding="9,6"
                                                    Background="#A0000000">
                                                <TextBlock Text="{Binding Resolution}"
                                                           FontSize="10"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border x:Name="LoadingOverlay"
                            Width="112"
                            Height="112"
                            CornerRadius="12"
                            Background="#E622262E"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Grid Width="34" Height="34" HorizontalAlignment="Center">
                                <Ellipse Stroke="#3AFFFFFF"
                                         StrokeThickness="3"/>
                                <Ellipse Stroke="#FFB8A7AE"
                                         StrokeThickness="3"
                                         StrokeDashArray="2,6"
                                         StrokeStartLineCap="Round">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="LoadingRotateTransform"
                                                         CenterX="17"
                                                         CenterY="17"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <TextBlock x:Name="LoadingText"
                                       Text="Ładowanie"
                                       Margin="0,12,0,0"
                                       Foreground="#FFD8D1D4"
                                       FontSize="11"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="StatusPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   Foreground="#FFC9C2C5"
                                   FontSize="13"
                                   TextAlignment="Center"/>
                        <Button x:Name="RetryButton"
                                Content="Spróbuj ponownie"
                                Style="{StaticResource FlatButtonStyle}"
                                Margin="0,14,0,0"
                                Visibility="Collapsed"
                                Click="RefreshButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border x:Name="ResizeGrip"
                    Width="26"
                    Height="26"
                    Grid.RowSpan="3"
                    Panel.ZIndex="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="SizeNWSE"
                    MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                    MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                    MouseMove="ResizeGrip_MouseMove">
                <Canvas Width="16"
                        Height="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,5,5"
                        Opacity=".48">
                    <Path Data="M 15 6 L 6 15"
                          Stroke="White"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <Path Data="M 15 11 L 11 15"
                          Stroke="White"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Canvas>
            </Border>
        </Grid>
    </Border>
</Window>
