<Window x:Class="MyFancyFencesStats.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Fancy Fences — Download Stats"
        Width="680" Height="560" MinWidth="520" MinHeight="390"
        WindowStartupLocation="CenterScreen"
        Background="#FF111216" Foreground="#FFF0EDF0"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Foreground" Value="#FFF2EEF1"/>
            <Setter Property="Background" Value="#FF2B2D34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF3A3D46"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="My Fancy Fences" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="GitHub download statistics" Margin="0,4,0,0"
                           Foreground="#FFA8A3AA" FontSize="12"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Content="Odśwież"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="RefreshButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,14" Padding="18,14"
                Background="#FF1D2026" BorderBrush="#FF30333B"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Łączna liczba pobrań" Foreground="#FFAAA5AC" FontSize="11"/>
                    <TextBlock Text="{Binding TotalDownloads}" Margin="0,3,0,0"
                               FontSize="30" FontWeight="SemiBold" Foreground="#FF8ED6AD"/>
                </StackPanel>
                <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dzisiaj" Foreground="#FFAAA5AC" FontSize="11"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding TodayDownloads, StringFormat=+{0}}" Margin="0,3,0,0"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#FF8ED6AD"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Wydania" Foreground="#FFAAA5AC" FontSize="11"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding ReleaseCount}" Margin="0,3,0,0"
                                   FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Wydania" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Releases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,5,10" Padding="15,12"
                                        Background="#FF1A1C21" BorderBrush="#FF2E3037"
                                        BorderThickness="1" CornerRadius="9">
                                    <Grid>
                                        <TextBlock Text="{Binding Tag}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Total, StringFormat={}{0} pobrań}"
                                                   HorizontalAlignment="Right" Foreground="#FF8ED6AD"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Pobrania dziennie" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding DailyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,5,8" Padding="12,10"
                                        Background="#FF1A1C21" BorderBrush="#FF2E3037"
                                        BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <TextBlock Text="{Binding DateText}" Foreground="#FFE8E3E7"/>
                                        <TextBlock Text="{Binding DownloadsText}" HorizontalAlignment="Right"
                                                   FontWeight="SemiBold" Foreground="#FF8ED6AD"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="2,8,2,0"
                   Foreground="#FF8F8A91" FontSize="10.5"/>
    </Grid>
</Window>
